{
  "name": "@genica/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./motion.css": "./src/styles/motion.css",
    "./brand": "./src/brand/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx",
    "./ui/*": "./src/components/ui/*.tsx"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@genica/tsconfig": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "react": "^19.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}
